{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Xophz Magic Hat",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": true,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"name": "Brand Base",
					"slug": "brand-base",
					"color": "#62c9ff"
				},
				{
					"name": "Brand Hover",
					"slug": "brand-hover",
					"color": "#8be0ff"
				},
				{
					"name": "Brand Active",
					"slug": "brand-active",
					"color": "#40a0df"
				},
				{
					"name": "Brand Muted",
					"slug": "brand-muted",
					"color": "#1a3a4d"
				},
				{
					"name": "Action Base",
					"slug": "cta-base",
					"color": "#ff3366"
				},
				{
					"name": "Action Hover",
					"slug": "cta-hover",
					"color": "#ff668c"
				},
				{
					"name": "Action Active",
					"slug": "cta-active",
					"color": "#e62050"
				},
				{
					"name": "Action Muted",
					"slug": "cta-muted",
					"color": "#4d1a26"
				},
				{
					"name": "Link Default",
					"slug": "link-default",
					"color": "#62c9ff"
				},
				{
					"name": "Link Hover",
					"slug": "link-hover",
					"color": "#ff3366"
				},
				{
					"name": "Text Heading",
					"slug": "text-heading",
					"color": "#ffffff"
				},
				{
					"name": "Text Main",
					"slug": "text-main",
					"color": "#f8fafc"
				},
				{
					"name": "Text Muted",
					"slug": "text-muted",
					"color": "#94a3b8"
				},
				{
					"name": "Text Inverse",
					"slug": "text-inverse",
					"color": "#0f172a"
				},
				{
					"name": "Surface Body",
					"slug": "surface-body",
					"color": "#0a0b10"
				},
				{
					"name": "Surface Main",
					"slug": "surface-main",
					"color": "#0f172a"
				},
				{
					"name": "Surface Section",
					"slug": "surface-section",
					"color": "rgba(255, 255, 255, 0.02)"
				},
				{
					"name": "Surface Card",
					"slug": "surface-card",
					"color": "rgba(255, 255, 255, 0.05)"
				},
				{
					"name": "Status Success",
					"slug": "status-success",
					"color": "#10b981"
				},
				{
					"name": "Status Warning",
					"slug": "status-warning",
					"color": "#f59e0b"
				},
				{
					"name": "Status Danger",
					"slug": "status-danger",
					"color": "#ef4444"
				},
				{
					"name": "Status Info",
					"slug": "status-info",
					"color": "#3b82f6"
				}
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"fontFamilies": [
				{
					"fontFamily": "'Outfit', sans-serif",
					"name": "Outfit",
					"slug": "heading"
				},
				{
					"fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
					"name": "Inter",
					"slug": "body"
				},
				{
					"fontFamily": "'JetBrains Mono', monospace",
					"name": "JetBrains Mono",
					"slug": "mono"
				}
			],
			"fontSizes": [
				{
					"name": "Extra Small",
					"size": "0.75rem",
					"slug": "xs"
				},
				{
					"name": "Small",
					"size": "0.875rem",
					"slug": "sm"
				},
				{
					"name": "Base",
					"size": "1rem",
					"slug": "base"
				},
				{
					"name": "Large",
					"size": "1.125rem",
					"slug": "lg"
				},
				{
					"name": "Extra Large",
					"size": "1.25rem",
					"slug": "xl"
				},
				{
					"name": "2X Large",
					"size": "1.5rem",
					"slug": "2xl"
				},
				{
					"name": "3X Large",
					"size": "1.875rem",
					"slug": "3xl"
				},
				{
					"name": "4X Large",
					"size": "2.25rem",
					"slug": "4xl"
				}
			]
		},
		"spacing": {
			"customSpacingSize": true,
			"units": ["%", "px", "em", "rem", "vh", "vw"],
			"spacingSizes": [
				{
					"name": "1",
					"size": "0.25rem",
					"slug": "1"
				},
				{
					"name": "2",
					"size": "0.5rem",
					"slug": "2"
				},
				{
					"name": "3",
					"size": "0.75rem",
					"slug": "3"
				},
				{
					"name": "4",
					"size": "1rem",
					"slug": "4"
				},
				{
					"name": "6",
					"size": "1.5rem",
					"slug": "6"
				},
				{
					"name": "8",
					"size": "2rem",
					"slug": "8"
				},
				{
					"name": "12",
					"size": "3rem",
					"slug": "12"
				}
			]
		},
		"layout": {
			"contentSize": "840px",
			"wideSize": "1340px"
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|surface-body",
			"text": "var:preset|color|text-main"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|base",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|link-default"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|link-hover"
					},
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "700"
				},
				"color": {
					"text": "var:preset|color|text-heading"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|brand-base",
					"text": "var:preset|color|surface-body"
				},
				"border": {
					"radius": "4px"
				},
				"typography": {
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|brand-hover",
						"text": "var:preset|color|surface-body"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	],
	"customTemplates": [
		{
			"name": "blank",
			"postTypes": ["page", "post"],
			"title": "Blank Canvas"
		}
	]
}
